    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@xyflow/system": "0.0.83",
    "class-variance-authority": "0.7.1",
    "lucide-react": "0.564.0",
    "motion": "12.43.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
