{
  "name": "@radix/lineage-ui",
  "version": "0.0.0-prepared",
  "description": "Prepared lineage UI for Radix's t3module subproject; not yet connected to the T3 application.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
